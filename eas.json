{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_TESTER_TOOLS": "on"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TESTER_TOOLS": "off"
      }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_TESTER_TOOLS": "on"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {}
  }
}
